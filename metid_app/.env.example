# ── Copy to .env and fill in values (never commit .env) ──────────────────────

APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=debug
SECRET_KEY=dev-secret-change-me

# Postgres (production)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/metid

# SQLite (local dev)
DATABASE_URL=sqlite+aiosqlite:///./metid_dev.db

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Cloud storage (leave blank for local)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/metid_results
# S3_BUCKET=my-metid-bucket
# GCS_BUCKET=my-metid-bucket

# SyGMa tuning
SYGMA_PHASE1_CYCLES=1
SYGMA_PHASE2_CYCLES=1
MAX_METABOLITES_RETURNED=200

# ML plug-ins (comma-separated module paths, blank = rule-based only)
ENABLED_ML_PREDICTORS=

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
